# Hostile Takeover production secrets. Copy to .env.prod (gitignored, mode 600) -- or just run
# ./ht-init-prod.sh, which writes it with random values. Never commit the real file.
# docker-compose.prod.yml holds the non-secret settings (domains, ports, worker count).

# ht-db (Postgres 17). Used on first start only; changing them later does not change the database.
POSTGRES_DB=hostile_takeover
POSTGRES_USER=hostile_takeover
POSTGRES_PASSWORD=change_me

# ht-api's connection to it. Keep these equal to the POSTGRES_* values above.
HT_DB_NAME=hostile_takeover
HT_DB_USER=hostile_takeover
HT_DB_PASSWORD=change_me

# Shared secret the game server sends the API (x-api-key). Same value is read by both containers.
API_KEY=change_me

# Sign in with GLL ID (GATE). Read by ht-api (this file is its env_file). Empty GATE_ISSUER = off.
# GATE_ISSUER=https://id.taps-holdings.org
# GATE_CLIENT_ID=hostile-takeover
# GATE_CLIENT_SECRET=change_me
# GATE_REDIRECT_URI defaults to <API_URL>/auth/gate/callback; GATE_POST_LOGOUT_URI to <GAME_ORIGIN>/.
# GATE_BACKCHANNEL_URL=
# LEGACY_LOGIN=on   # "off" = password sign-in and sign-up disabled (GATE only)

# Optional, read by ht-deploy.sh at build time: footer link to Meridian (http/https URL). Empty hides it.
# MERIDIAN_URL=

# Optional: where the JWT signing key lives on the host (mounted read-only into ht-api).
# HT_KEYS_DIR=/home/you/.config/hostile-takeover/keys
