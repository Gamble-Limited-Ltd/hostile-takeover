# SSH Configuration
SSH_KEY=~/.ssh/your-ssh-key

# Docker Configuration
GHCR_USERNAME=username
GHCR_REPO=your-repo-name
GHCR_TOKEN=your_docker_token_here

DOMAIN=your-domain.com

# API Key
API_KEY=your_api_key_here

# Optional CDN origin (e.g. https://cdn.example.com) prepended to hashed asset
# URLs from asset-manifest.json. Leave empty to serve assets from the same
# origin as the app. No trailing slash.
CDN_BASE=

# Server Hosts
SERVER_HOST_STAGING=123.456.78.90
SERVER_HOST_NBG1=123.456.78.92

# Version
VERSION_TAG="latest"

# Grafana Faro collector URL for browser client telemetry (errors, web
# vitals). Leave empty to keep client telemetry off.
FARO_COLLECTOR_URL=
# Optional: account API origin when it is not api.<DOMAIN> (e.g. https://hostile-takeover-api.taps-holdings.org)
API_URL=

# Server OTEL log/metric export: off unless BOTH are set (and GAME_ENV is not dev).
# Hostile Takeover leaves them empty.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_AUTH_HEADER=

# Private match telemetry (disabled by default)
TELEMETRY_ENABLED=false
TELEMETRY_INGEST_URL=
TELEMETRY_SIGNING_SECRET=
TELEMETRY_BATCH_SIZE=200
TELEMETRY_FLUSH_INTERVAL_MS=1000
TELEMETRY_REQUEST_TIMEOUT_MS=5000
TELEMETRY_MAX_QUEUE_SIZE=20000
TELEMETRY_MAX_QUEUE_BYTES=33554432
TELEMETRY_MAX_EVENT_BYTES=1048576
TELEMETRY_PER_PLAYER_PER_TICK_CAP=32

# Dev ports. The master listens on MASTER_PORT, workers on the next ports up
# (MASTER_PORT+1, +2, ...), and Vite on VITE_PORT. Defaults are 3000 and 9000;
# Hostile Takeover uses 3400 and 5178 on the shared VM so GLL/Meridian aren't hit.
MASTER_PORT=3400
VITE_PORT=5178

# Hostile Takeover API (packages/api) and its Postgres (docker-compose.dev.yml).
# API_PORT defaults to 8787; set HT_DB_MIGRATE_ON_BOOT=true to migrate at startup.
API_PORT=8787
HT_DB_HOST=127.0.0.1
HT_DB_PORT=5436
HT_DB_NAME=hostile_takeover
HT_DB_USER=hostile_takeover
HT_DB_PASSWORD=change_me
HT_DB_MIGRATE_ON_BOOT=false

# Hostile Takeover API identity (Slice 1.3). API_URL must equal the game server's
# jwtIssuer(); `npm run api:keygen` writes the Ed25519 key at HT_JWT_PRIVATE_KEY_FILE.
API_URL=http://localhost:8787
DOMAIN=localhost
GAME_ORIGIN=http://localhost:5178
# LAN dev mode (`npm run dev:lan` sets these inline; do not put them in .env):
# API_HOST defaults to 127.0.0.1 (the API listens on loopback only); EXTRA_GAME_ORIGINS is a
# comma-separated list of extra CORS origins (default none); LAN_HOST overrides the detected LAN IP.
# API_HOST=0.0.0.0
# EXTRA_GAME_ORIGINS=http://10.1.1.251:5178
# LAN_HOST=10.1.1.251
# Sign in with GLL ID (GATE, an OIDC provider). Leave GATE_ISSUER empty to turn it off.
# GATE_REDIRECT_URI defaults to $API_URL/auth/gate/callback and must be registered with GATE exactly;
# GATE_POST_LOGOUT_URI defaults to $GAME_ORIGIN/. GATE_BACKCHANNEL_URL, if set, replaces the issuer's
# origin for server-to-server fetches only (discovery, token, JWKS), e.g. a Docker-network address.
# LEGACY_LOGIN=off disables username/password sign-in and sign-up (GATE becomes the only way in;
# existing accounts can still claim themselves with their password once, to link to GATE).
# GATE_ISSUER=http://127.0.0.1:3302
# GATE_CLIENT_ID=hostile-takeover
# GATE_CLIENT_SECRET=
# GATE_REDIRECT_URI=
# GATE_POST_LOGOUT_URI=
# GATE_BACKCHANNEL_URL=
# GATE_DIRECT_URL is where the server reaches GATE for discovery, JWKS, token and the "Redirect failed?"
# direct sign-in (default: the issuer). The id_token iss must still equal GATE_ISSUER.
# GATE_DIRECT_URL=http://127.0.0.1:3302
# LEGACY_LOGIN=on
HT_JWT_PRIVATE_KEY_FILE=packages/api/.keys/jwt-ed25519.pem
API_KEY=WARNING_DEV_API_KEY_DO_NOT_USE_IN_PRODUCTION
# Dev-only passwords for `npm run api:seed` (users thestrongest and tester1).
HT_SEED_PASSWORD_THESTRONGEST=change_me
HT_SEED_PASSWORD_TESTER1=change_me

# The one game server as cluster.json reports it (host[:port], no scheme) and the
# commit-like version string it advertises (a hex client build must match it).
# A loopback host (localhost, 127.0.0.1, ::1) makes /cluster.json answer 404, so
# the client uses the page's own origin (no TLS in local dev).
HT_GAME_HOST=localhost:3400
HT_GAME_VERSION=0000000

# Cloudflare Turnstile site key. Unset or empty (the default here) turns Turnstile off:
# no widget script, no token, no server check. Set it to bring upstream behaviour back.
# TURNSTILE_SITE_KEY=

# Ranked matchmaking check-in loops on each game worker. Hostile Takeover has
# no ranked queue, so they are off; only the exact value "true" turns them on.
# RANKED_ENABLED=false

# Build-time. Link to the Meridian game in the footer (next to Gamble Limited). Unset
# or empty (the default) hides it. Must be an http(s) URL. Not read at runtime.
# MERIDIAN_URL=
